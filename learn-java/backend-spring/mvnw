#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper Shell Script for Linux/macOS
# ----------------------------------------------------------------------------

export MAVEN_PROJECTBASEDIR="${PWD}"
WRAPPER_JAR="${MAVEN_PROJECTBASEDIR}/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="${MAVEN_PROJECTBASEDIR}/.mvn/wrapper/maven-wrapper.properties"

if [ ! -f "$WRAPPER_JAR" ]; then
    echo "[INFO] Downloading Maven Wrapper jar..."
    mkdir -p "${MAVEN_PROJECTBASEDIR}/.mvn/wrapper"
    curl -sLo "$WRAPPER_JAR" "https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
fi

exec java -Dmaven.multiModuleProjectDirectory="$MAVEN_PROJECTBASEDIR" -jar "$WRAPPER_JAR" "$@"

