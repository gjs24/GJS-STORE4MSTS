# Environment files with real secrets
.env
.env.*
*.env
*.env.*
frontend/.env*
backend/.env*
mobile/.env*
desktop/.env*
desktop/renderer/.env*
!.env.example
!*.env.example

# Local Python/Django runtime data
backend/.venv/
backend/db.sqlite3
*.sqlite3
*.db
backend/media/
backend/staticfiles/

# Frontend/mobile/desktop dependency and build output
frontend/.next/
frontend/node_modules/
frontend/out/
frontend/dist/

mobile/node_modules/
mobile/.expo/
mobile/dist/

desktop/node_modules/
desktop/renderer/node_modules/
desktop/dist/
desktop/release/
desktop/renderer/.next/
desktop/renderer/out/

# Caches and compiled files
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.tsbuildinfo
.next/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Private keys, certificates, and local credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
service-account*.json
credentials*.json
secrets*.json
