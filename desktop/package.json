{
  "name": "gjs-railforge-launcher",
  "version": "1.0.0",
  "private": true,
  "description": "GJS RailForge Launcher",
  "author": "GJS Production",
  "main": "dist-electron/main.js",
  "scripts": {
    "renderer": "cd renderer && npm run dev",
    "electron": "wait-on http://localhost:3000 && cross-env ELECTRON_RENDERER_URL=http://localhost:3000 electron .",
    "dev": "concurrently \"npm run renderer\" \"npm run electron\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "npm --prefix renderer run build",
    "build": "npm run build:electron && npm run build:renderer",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.gjsproduction.railforge",
    "productName": "GJS RailForge Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-electron/**/*",
      "renderer/out/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "typescript": "^5.9.2",
    "wait-on": "^9.1.0"
  }
}